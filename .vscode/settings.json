{
    // editor
    "editor.formatOnSave": true,
    "cSpell.import": ["${workspaceFolder}/cspell.yaml"],
    "editor.rulers": [100],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "[shellscript][ignore][dotenv][properties]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "[svelte]": {
        "editor.defaultFormatter": "svelte.svelte-vscode"
    },

    // eslint
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.validate": ["svelte", "javascript", "typescript", "javascriptreact", "typescriptreact"],

    // tailwind
    "files.associations": {
        "*.css": "tailwindcss"
    },

    // Svelte
    "svelte.enable-ts-plugin": true,
    // This is here to fix this error: https://github.com/windicss/vite-plugin-windicss/issues/98
    // where the IDE shows an error but the code actually works.
    "svelte.plugin.svelte.diagnostics.enable": false,

    // for windows users
    "terminal.integrated.profiles.windows": {
        "GitBash": {
            "source": "Git Bash",
            "path": ["C:\\Program Files\\Git\\bin\\bash.exe"]
        }
    },
    "terminal.integrated.defaultProfile.windows": "GitBash",

    // etc
    "search.exclude": {
        "pnpm-lock.yaml": true,
        "**.svg": true
    }
}
