{
    "extends": "@warbrokers/typescript-config/base.json",
    "compilerOptions": {
        // regular configs
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node"],

        // node version related
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ESNext",

        // path related
        "paths": {
            "~/*": ["./src/*"]
        }
    },
    "include": ["src", "tsup.config.ts"]
}
