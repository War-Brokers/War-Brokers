{
    "compilerOptions": {
        // generation related
        "outDir": "build",
        "declaration": true,

        // regular configs
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "types": ["node"],

        // node version related
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ESNext",

        // path related
        "paths": {
            "~/*": ["./src/*"]
        }
    },
    "include": ["src", "tsup.config.ts"]
}
