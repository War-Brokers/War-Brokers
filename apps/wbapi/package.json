{
    "name": "@warbrokers/wbapi",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./build/index.js",
    "scripts": {
        "dev": "pnpm build && ../../scripts/wait-for-port 4000 && pnpm start:dev",
        "build": "rm -rf build && tsup && tsc --emitDeclarationOnly",
        "start:dev": "NODE_ENV=development node .",
        "start:prod": "node .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test:unit": "jest",
        "clean": "rm -rf .turbo build node_modules *.log"
    },
    "dependencies": {
        "@t3-oss/env-core": "0.11.1",
        "@trpc/server": "10.45.4",
        "@warbrokers/types": "workspace:*",
        "cors": "2.8.5",
        "dotenv": "16.4.5",
        "drizzle-orm": "0.45.2",
        "drizzle-zod": "0.5.1",
        "express": "5.0.1",
        "express-rate-limit": "8.2.1",
        "postgres": "3.4.5",
        "swagger-ui-express": "5.0.1",
        "trpc-openapi": "1.2.0",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@swc/core": "1.9.3",
        "@types/cors": "2.8.17",
        "@types/express": "5.0.0",
        "@types/jest": "29.5.14",
        "@types/swagger-ui-express": "4.1.7",
        "@warbrokers/eslint-config": "workspace:*",
        "@warbrokers/typescript-config": "workspace:*",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.3",
        "jest": "29.7.0",
        "openapi-types": "12.1.3",
        "ts-jest": "29.4.12",
        "tsup": "8.5.1",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": "26.6.0",
        "pnpm": "11.20.0"
    }
}
