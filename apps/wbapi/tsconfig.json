{
    "compilerOptions": {
        // generation related
        "outDir": "build",
        "declaration": true,

        // regular configs
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "types": ["node", "jest"],

        // node version related
        "moduleResolution": "bundler",
        "module": "es2022",
        "lib": ["ES2022", "DOM"], // trpc needs the DOM lib
        "target": "ES2022",

        // path related
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "tsup.config.ts"]
}
