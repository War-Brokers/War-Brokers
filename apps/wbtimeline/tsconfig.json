{
    "extends": "@warbrokers/typescript-config/base.json",
    "compilerOptions": {
        "target": "es2015",
        "lib": ["dom", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "noUncheckedSideEffectImports": false,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"]
        },
        "strict": true,
        "esModuleInterop": true
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
