#!/usr/bin/env -S mise -E dev exec -- bash
#MISE description="Run Lighthouse against local services"
#MISE hide=true

set -euo pipefail
set -m

readonly base_url="http://127.0.0.1:4173"
readonly player_uid="5d2ead35d142affb05757778"
readonly reports_dir="${MISE_PROJECT_ROOT}/.mise/lighthouse"
readonly routes=(
    "home|/"
    "comparison|/${player_uid}-vs-${player_uid}"
    "leaderboard|/leaderboard"
    "leaderboard-daily|/leaderboard/daily"
    "leaderboard-daily-kills|/leaderboard/daily/kills"
    "leaderboard-daily-battle-royale-wins|/leaderboard/daily/battleRoyaleWins"
    "leaderboard-daily-classic-mode-wins|/leaderboard/daily/classicModeWins"
    "leaderboard-games-elo|/leaderboard/gamesELO"
    "leaderboard-kills-elo|/leaderboard/killsELO"
    "leaderboard-time-alive|/leaderboard/timeAlive"
    "leaderboard-xp|/leaderboard/xp"
    "player|/players/${player_uid}"
    "ranks|/ranks"
    "servers|/servers"
    "squads|/squads"
    "squad-lp|/squads/LP"
)

CHROME_PATH="$(pnpm --filter=@warbrokers/stats-site exec node --input-type=module -e \
    "import { chromium } from '@playwright/test'; process.stdout.write(chromium.executablePath())")"
test -x "$CHROME_PATH"
export CHROME_PATH

if (printf '' >/dev/tcp/127.0.0.1/4173) >/dev/null 2>&1; then
    printf 'Port 4173 is already in use.\n' >&2
    exit 1
fi

HOST=127.0.0.1 PORT=4173 pnpm --filter=@warbrokers/stats-site exec node build &
server_pid=$!
declare -A audit_pids=()

cleanup() {
    status=$?
    trap - EXIT INT TERM

    for pid in "${!audit_pids[@]}"; do
        kill -INT -- "-$pid" >/dev/null 2>&1 || true
        wait "$pid" >/dev/null 2>&1 || true
    done

    kill -INT -- "-$server_pid" >/dev/null 2>&1 || true
    wait "$server_pid" >/dev/null 2>&1 || true

    exit "$status"
}

trap cleanup EXIT INT TERM
./scripts/wait-for-port 4173 "$server_pid"

rm -rf "$reports_dir"
mkdir -p "$reports_dir"

audit_route() {
    local name="$1"
    local route="$2"

    printf '\nAuditing %s\n' "$route"
    pnpm --filter=@warbrokers/stats-site exec lighthouse "${base_url}${route}" \
        --quiet \
        --chrome-flags="--headless --no-sandbox" \
        --preset=desktop \
        --output=html \
        --output=json \
        --output-path="${reports_dir}/${name}"
}

audit_status=0
for entry in "${routes[@]}"; do
    name="${entry%%|*}"
    route="${entry#*|}"

    audit_route "$name" "$route" &
    audit_pids[$!]="$route"
done

for pid in "${!audit_pids[@]}"; do
    if ! wait "$pid"; then
        printf 'Lighthouse failed for %s.\n' "${audit_pids[$pid]}" >&2
        audit_status=1
    fi
    unset 'audit_pids[$pid]'
done

if ((audit_status != 0)); then
    exit 1
fi

printf '\nLighthouse reports: %s\n' "$reports_dir"
node --input-type=module - "$reports_dir" "${routes[@]}" <<'NODE'
import { readFile } from "node:fs/promises"
import { join } from "node:path"

const [reportsDir, ...entries] = process.argv.slice(2)
const rows = await Promise.all(
    entries.map(async (entry) => {
        const [name, route] = entry.split("|")
        const report = JSON.parse(
            await readFile(join(reportsDir, `${name}.report.json`), "utf8"),
        )
        const score = (category) => Math.round(report.categories[category].score * 100)
        const value = (audit) => report.audits[audit].numericValue
        const seconds = (audit) => (value(audit) / 1000).toFixed(2)

        return {
            Route: route,
            Perf: score("performance"),
            A11y: score("accessibility"),
            "Best practices": score("best-practices"),
            SEO: score("seo"),
            "Agentic browsing": score("agentic-browsing"),
            "FCP (s)": seconds("first-contentful-paint"),
            "LCP (s)": seconds("largest-contentful-paint"),
            "Speed idx (s)": seconds("speed-index"),
            "TBT (ms)": Math.round(value("total-blocking-time")),
            CLS: value("cumulative-layout-shift").toFixed(3),
            "TTI (s)": seconds("interactive"),
            "Main thread (s)": seconds("mainthread-work-breakdown"),
            "Transfer (KiB)": Math.round(value("total-byte-weight") / 1024),
        }
    }),
)

console.table(rows)

if (rows.filter((row) => row.A11y !== 100).length > 0) {
    console.error("Accessibility must score 100 on every audited route.")
    process.exitCode = 1
}

if (rows.filter((row) => row["Best practices"] !== 100).length > 0) {
    console.error("Best practices must score 100 on every audited route.")
    process.exitCode = 1
}

if (rows.filter((row) => row.SEO !== 100).length > 0) {
    console.error("SEO must score 100 on every audited route.")
    process.exitCode = 1
}


if (rows.filter((row) => row["Agentic browsing"] !== 100).length > 0) {
    console.error("Agentic browsing must score 100 on every audited route.")
    process.exitCode = 1
}
NODE
