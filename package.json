{
    "name": "warbrokers",
    "private": true,
    "type": "module",
    "scripts": {
        "turbo": "turbo",
        "dev": "mise run dev",
        "build": "turbo run build --cache-dir=.turbo",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint oxfmt.config.ts && turbo run lint",
        "typecheck": "turbo run typecheck",
        "test:e2e": "turbo run test:e2e",
        "test:unit": "turbo run test:unit",
        "clean": "turbo run clean && rm -rf .turbo node_modules"
    },
    "devDependencies": {
        "@types/node": "26.2.0",
        "oxfmt": "0.62.0",
        "oxlint": "1.79.0",
        "turbo": "2.10.7",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": "26.6.0",
        "pnpm": "11.20.0"
    },
    "packageManager": "pnpm@11.20.0"
}
