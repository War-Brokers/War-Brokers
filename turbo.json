{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [".prettierignore", ".prettierrc.json"],
    "globalEnv": ["CI"],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true,
            "env": ["DATABASE_URL", "NODE_ENV", "WB_DB_BASE", "WB_DB_ID", "WB_DB_PW"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "out/**",
                "dist/**",
                "build/**",
                ".svelte-kit/**"
            ]
        },
        "lint": { "dependsOn": ["^build", "^lint"] },
        "typecheck": { "dependsOn": ["^build", "^typecheck"] },
        "transit": { "dependsOn": ["^transit"] },
        "test:e2e": {
            "env": ["PLAYWRIGHT_BROWSERS_PATH", "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS"],
            "cache": false
        },
        "test:unit": { "dependsOn": ["transit"] },
        "clean": {
            "cache": false
        }
    }
}
