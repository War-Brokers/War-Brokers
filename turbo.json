{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [".prettierignore", ".prettierrc.json"],
    "globalEnv": ["CI"],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "out/**",
                "dist/**",
                "build/**",
                ".svelte-kit/**"
            ]
        },
        "lint": { "dependsOn": ["^build", "^lint"] },
        "typecheck": { "dependsOn": ["^build", "^typecheck"] },
        "test:e2e": {
            "env": [
                "PLAYWRIGHT_BROWSERS_PATH",
                "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS"
            ],
            "dependsOn": ["^test:e2e"]
        },
        "test:unit": { "dependsOn": ["^test:unit"] },
        "clean": {
            "cache": false
        }
    }
}
